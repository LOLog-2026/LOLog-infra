# /etc/lolog/llm.env (1호 젯슨만, 권한 640, root:lolog)
LLM_MODEL_PATH=/opt/lolog/models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
LLM_ALIAS=qwen3-4b-q4
# 1호 젯슨의 Tailscale 주소(tailnet 안에서만 보임). 같은 LAN 주소를 쓰면 방화벽(ufw)으로 2호만 들어오게 막는다
LLM_HOST=100.98.23.5
LLM_CTX=24576
# openssl rand -hex 32 로 만든 값. 두 젯슨의 worker.env LLM_API_KEY와 같아야 함
LLM_API_KEY=change-me
