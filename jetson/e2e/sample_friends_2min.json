 "sentences": [
  {
   "startMs": 0,
   "endMs": 3240,
   "text": "야 나 어제 진짜 웃긴 일 있었어"
  },
  {
   "startMs": 3840,
   "endMs": 5340,
   "text": "뭔데 또"
  },
  {
   "startMs": 5940,
   "endMs": 11880,
   "text": "편의점에서 삼각김밥 사고 계산하려는데 지갑을 안 가져온 거야"
  },
  {
   "startMs": 12480,
   "endMs": 15000,
   "text": "그래서 폰으로 하려고 했지"
  },
  {
   "startMs": 15600,
   "endMs": 19740,
   "text": "근데 폰도 배터리가 나가서 꺼져 있는 거야"
  },
  {
   "startMs": 20340,
   "endMs": 23040,
   "text": "아 대박 그래서 어떻게 했어"
  },
  {
   "startMs": 23640,
   "endMs": 29400,
   "text": "알바생이 나를 엄청 불쌍하게 보더니 그냥 가져가라고 하더라"
  },
  {
   "startMs": 30000,
   "endMs": 31500,
   "text": "헐 착하다"
  },
  {
   "startMs": 32100,
   "endMs": 35880,
   "text": "근데 그 알바생이 우리 과 조교님이었어"
  },
  {
   "startMs": 36480,
   "endMs": 40260,
   "text": "아 진짜 미쳤다 그럼 내일 수업 어떡해"
  },
  {
   "startMs": 40860,
   "endMs": 45720,
   "text": "그니까 내일 수업 들어가서 삼각김밥 값 드려야 돼"
  },
  {
   "startMs": 46320,
   "endMs": 49380,
   "text": "그거 이자 붙여서 두 개 드려라"
  },
  {
   "startMs": 49980,
   "endMs": 54300,
   "text": "아 그 얘기 하니까 배고프다 밥 먹으러 가자"
  },
  {
   "startMs": 54900,
   "endMs": 56400,
   "text": "그래 학식 가자"
  }
 ]
}