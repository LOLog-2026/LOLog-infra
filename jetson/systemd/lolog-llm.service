# LLM 서버 (llama.cpp llama-server, OpenAI 호환 /v1). 1호 젯슨만.
# 2호 젯슨의 만화 워커도 콘티를 만들 때 이 서버를 부르므로 LAN 주소에 열고 API 키를 건다.
# --cache-ram 0: llama.cpp의 RAM 프롬프트 캐시(기본 8GB)가 젯슨 메모리(7.3GB)를 넘겨 스왑을 7GB까지 씀
# --reasoning-budget 0, enable_thinking=false: Qwen3.5의 생각(thinking) 모드를 끔. 켜면 출력이 몇 배로 늘어 느려짐
# --spec-type ngram-simple: 입력 글을 옮겨 쓰는 출력(화자 나누기)을 n-gram 추측 디코딩으로 약 1.9배 빠르게. 출력 분포·메모리는 그대로
#   (1호에는 11/11 측정 뒤 기기에만 넣어 두었던 옵션을 레포에 맞춤)
[Unit]
Description=LOLog LLM server (llama.cpp)
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
User=lolog
EnvironmentFile=/etc/lolog/llm.env
ExecStart=/opt/lolog/llama.cpp/build/bin/llama-server \
  -m ${LLM_MODEL_PATH} --alias ${LLM_ALIAS} \
  --host ${LLM_HOST} --port 8000 --api-key ${LLM_API_KEY} \
  -c ${LLM_CTX} -np 1 -ngl 99 -fa on -ctk q8_0 -ctv q8_0 --jinja \
  --cache-ram 0 --reasoning-budget 0 --chat-template-kwargs '{"enable_thinking":false}' \
  --spec-type ngram-simple --spec-ngram-simple-size-n 3 --spec-ngram-simple-size-m 12
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
