# /etc/lolog/worker.env (권한 640, root:lolog). spec/deployment.md 7장
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0
API_INTERNAL_URL=http://localhost:18080
INTERNAL_TOKEN=change-me
# 1호·2호 모두 1호의 Tailscale 주소 (llama-server를 그 주소에만 열기 때문에 1호도 localhost가 아님)
LLM_BASE_URL=http://100.98.23.5:8000/v1
LLM_API_KEY=change-me
LLM_MODEL=qwen3-4b-q4
# 1호: jetson-1, 2호: jetson-2
WORKER_NAME=jetson-1
# 2호만: 그림 모델
# HF_HOME=/opt/lolog/hf-cache
# HF_HUB_OFFLINE=1
# FLUX_NF4_DIR=/opt/lolog/models/flux2-klein-4b-nf4
# FLUX_LORA=
