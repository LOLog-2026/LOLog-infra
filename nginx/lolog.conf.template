# 우리 nginx 컨테이너의 경로 나누기(deployment.md 2장).
# 템플릿이다. nginx 이미지가 뜰 때 ${S3_ENDPOINT}, ${S3_BUCKET}을 compose 환경 변수로 바꿔 conf.d/default.conf로 쓴다.
# 앞에 학교 Nginx가 있어서 도메인과 HTTPS는 거기서 끝나고, 여기서는 80(HTTP)으로 받는다.

# 학교 Nginx가 붙인 X-Real-IP를 진짜 사용자 주소로 쓴다(횟수 제한이 학교 Nginx 주소 하나로 묶이지 않게).
set_real_ip_from 127.0.0.1;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
real_ip_header X-Real-IP;

# 학교 Nginx가 알려 준 원래 프로토콜(https/http)을 그대로 넘긴다.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# 로그인·가입 요청 횟수 제한: IP마다 1분에 10번, 순간적으로 5번까지 더 받는다.
limit_req_zone $binary_remote_addr zone=auth_login:10m rate=10r/m;
limit_req_status 429;

# Docker 내부 DNS. api·auth를 다시 띄워 IP가 바뀌어도 10초 안에 새 주소를 찾는다.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80 default_server;
    server_name _;

    # 요청 본문은 5MB까지. 녹음 본문 1MB 제한(413)은 메인 백엔드가 검사한다.
    client_max_body_size 5m;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_read_timeout 60s;

    # 변수로 넘기면 요청마다 이름을 다시 찾고, 원래 URI를 자르지 않고 그대로 넘긴다.
    set $auth_upstream http://auth:8081;
    set $api_upstream  http://api:8080;

    # 서버끼리 쓰는 주소는 밖에 열지 않는다. Jetson은 터널 포트로 api에 바로 붙는다.
    location /internal/ {
        return 404;
    }

    location ~ ^/auth/(login|signup|social/) {
        limit_req zone=auth_login burst=5 nodelay;
        proxy_pass $auth_upstream;
    }

    location /auth/ {
        proxy_pass $auth_upstream;
    }

    location /api/ {
        proxy_pass $api_upstream;
    }

    # 만화 이미지(imageUrl). 미리 서명한 주소에 lolog.java21.net이 Host로 들어가 있어 Host를 바꾸지 않고 넘긴다.
    # GET(과 HEAD)만 받는다.
    location /${S3_BUCKET}/ {
        limit_except GET {
            deny all;
        }
        # 여기서 proxy_set_header를 하나라도 쓰면 위의 Host 설정이 사라져 서명이 깨진다. 넣지 않는다.
        # 교육기관 MinIO의 S3 API(.env의 S3_ENDPOINT, 컨테이너가 뜰 때 넣는다). 우리 컨테이너가 아니라 IP가 바뀌지 않으므로
        # 변수 없이 적어 뜰 때 한 번 찾는다. Docker DNS(resolver)는 host.docker.internal(/etc/hosts)을 모른다.
        # 주소 뒤에 경로가 없어서 원래 URI(/버킷/키?서명)를 그대로 넘긴다.
        proxy_pass ${S3_ENDPOINT};
    }

    # 서비스 소개 페이지(네이버 로그인 검수에 등록한 서비스 URL). site/index.html 한 장만 보여 준다.
    # 앱 받기 버튼은 LOLog-app GitHub 최신 릴리스로 가서, 새 APK는 릴리스만 올리면 된다.
    location = / {
        root /usr/share/nginx/site;
        try_files /index.html =404;
        add_header Cache-Control "no-cache";
    }

    # 소개 페이지 그림(로고). site/assets/ 안의 파일만
    location /assets/ {
        root /usr/share/nginx/site;
        expires 7d;
    }

    location / {
        return 404;
    }
}
