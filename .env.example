# 서버의 ~/lolog-infra/.env로 복사해 값을 채운다(cp .env.example .env). .env는 커밋하지 않는다.
# 비밀값은 `openssl rand -hex 32`로 만든다(따옴표·$가 없는 값이 안전하다).

# 앱과 imageUrl이 쓰는 공개 주소. HTTPS는 학교 Nginx가 Let's Encrypt로 맡는다.
PUBLIC_URL=https://lolog.java21.net

# 개인 포트 범위 8450~8459(8456, 8457은 이미 사용 중)에서 골랐다. Jetson 터널 설정과 같은 값이다.
# NGINX_PORT: 학교 Nginx 관리 웹사이트에 lolog.java21.net의 넘길 곳으로 등록할 포트
# TUNNEL_API_PORT, TUNNEL_REDIS_PORT: Jetson 터널이 붙는 포트(README "Jetson 터널")
NGINX_PORT=8450
TUNNEL_API_PORT=8451
TUNNEL_REDIS_PORT=8452

# 이미지 태그(커밋 SHA). GitHub Actions 배포가 scripts/deploy.sh로 고친다.
# 되돌릴 때는 `scripts/deploy.sh api <이전 SHA>`를 부른다.
API_TAG=
AUTH_TAG=

# 공통 비밀값(deployment.md 9장). JWT_SECRET은 32바이트 이상.
JWT_SECRET=
INTERNAL_TOKEN=

# PostgreSQL. 인증과 메인 백엔드가 같은 DB(lolog, public 스키마)를 쓴다.
POSTGRES_DB=lolog
DB_SCHEMA=public
POSTGRES_USER=lolog
POSTGRES_PASSWORD=

# Redis. Jetson 워커의 REDIS_URL에도 같은 값이 들어간다.
REDIS_PASSWORD=

# SeaweedFS. 버킷 이름을 바꾸면 nginx/lolog.conf의 /lolog-comics/ 경로도 같이 바꾼다.
S3_BUCKET=lolog-comics
S3_ACCESS_KEY=
S3_SECRET_KEY=
