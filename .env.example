# 서버의 ~/lolog-infra/.env로 복사해 값을 채운다(cp .env.example .env). .env는 커밋하지 않는다.
# 비밀값은 `openssl rand -hex 32`로 만든다(따옴표·$가 없는 값이 안전하다).

# 앱과 imageUrl이 쓰는 공개 주소. HTTPS는 학교 Nginx가 Let's Encrypt로 맡는다.
PUBLIC_URL=https://lolog.java21.net

# 개인 포트 범위 8450~8459(8456, 8457은 이미 사용 중)에서 골랐다. Jetson 터널 설정과 같은 값이다.
# NGINX_PORT: 학교 Nginx 관리 웹사이트에 lolog.java21.net의 넘길 곳으로 등록할 포트
# TUNNEL_API_PORT, TUNNEL_REDIS_PORT: Jetson 터널이 붙는 포트(README "Jetson 터널")
NGINX_PORT=8450
# 학교 Nginx는 컨테이너라 host.docker.internal로 붙는다. 127.0.0.1로 두면 닿지 않는다.
NGINX_BIND=0.0.0.0
TUNNEL_API_PORT=8451
TUNNEL_REDIS_PORT=8452

# 이미지 태그(커밋 SHA). GitHub Actions 배포가 scripts/deploy.sh로 고친다.
# 되돌릴 때는 `scripts/deploy.sh api <이전 SHA>`를 부른다.
API_TAG=
AUTH_TAG=

# 공통 비밀값(deployment.md 9장). JWT_SECRET은 32바이트 이상.
JWT_SECRET=
INTERNAL_TOKEN=

# PostgreSQL. 인증과 메인 백엔드가 같은 DB(lolog, public 스키마)를 쓴다.
POSTGRES_DB=lolog
DB_SCHEMA=public
POSTGRES_USER=lolog
POSTGRES_PASSWORD=

# Redis. Jetson 워커의 REDIS_URL에도 같은 값이 들어간다.
REDIS_PASSWORD=

# 교육기관 MinIO(만화 이미지). 버킷과 접근 키는 팀 계정으로 MinIO에서 만든다.
# S3_ENDPOINT: 서버 안에서 MinIO S3 API에 바로 닿는 주소(교육기관 MinIO는 서버 8000 포트: http://host.docker.internal:8000).
#   학교 Nginx(https://storage.java21.net)를 거치는 주소는 안 된다. 우리 nginx가 imageUrl을
#   Host: lolog.java21.net 그대로 넘겨야 서명이 맞는데, 학교 Nginx는 그 Host를 다시 우리에게 보낸다.
# S3_BUCKET: 공개 주소의 경로(/lolog-comics/...)도 이 이름을 따른다.
S3_ENDPOINT=http://host.docker.internal:8000
S3_REGION=us-east-1
S3_BUCKET=lolog-comics
S3_ACCESS_KEY=
S3_SECRET_KEY=

# 내 목소리(lolog-api, FR-CHAR-05). 비밀값 아님. false거나 없으면 내 목소리 만들기가 503으로 꺼진다.
# Jetson 3호 워커가 voice_clone을 처리할 수 있게 배포된 뒤에만 true로 바꾼다(먼저 켜면 워커가 그 작업을 쇼츠로 잘못 처리한다).
# 바꾼 뒤 `docker compose up -d api`로 api를 다시 띄워야 적용된다.
VOICE_CLONE_QUEUE_ENABLED=false

# 구글 로그인(lolog-auth). 백엔드가 준 구글 웹 클라이언트 ID(...apps.googleusercontent.com).
GOOGLE_WEB_CLIENT_ID=

# 가입 인증번호 메일(lolog-auth). Gmail SMTP로 보낸다.
# MAIL_PASSWORD는 보내는 계정의 Google 앱 비밀번호(16자, 공백 없이)다. 계정 로그인 비밀번호가 아니다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=devhjw02@gmail.com
MAIL_PASSWORD=
MAIL_FROM=devhjw02@gmail.com
